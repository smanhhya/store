<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>سمان ههيا | الإدارة المركزية (CRM المطور)</title>
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#166534">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { 
                        brand: { 
                            dark: '#064e3b', 
                            primary: '#166534', 
                            accent: '#f59e0b', 
                            bg: '#f8fafc', 
                            cyan: '#ef4444' 
                        } 
                    },
                    fontFamily: { cairo: ['Cairo', 'sans-serif'] },
                    boxShadow: {
                        'soft': '0 4px 20px -2px rgba(0, 0, 0, 0.05)',
                        'card': '0 2px 10px -3px rgba(6, 81, 237, 0.1)',
                    }
                }
            }
        }
    </script>
    
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>

    <style>
        body { font-family: 'Cairo', sans-serif; background-color: #f1f5f9; overflow: hidden; -webkit-font-smoothing: antialiased; }
        .custom-scroll::-webkit-scrollbar { width: 5px; height: 5px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 10px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background-color: #94a3b8; }
        
        .page-view { display: none !important; animation: fadeIn 0.3s ease-out forwards; }
        .page-view.active { display: flex !important; flex-direction: column; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        
        #sidebar { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        @media (max-width: 768px) { #sidebar { transform: translateX(100%); } #sidebar.open { transform: translateX(0); } }

        input, textarea, select { transition: all 0.2s ease; }
        input:focus, textarea:focus, select:focus {
            box-shadow: 0 0 0 3px rgba(22, 101, 52, 0.1);
            background-color: #ffffff;
        }
    </style>
</head>
<body class="text-slate-700 flex h-screen w-full relative selection:bg-brand-primary selection:text-white">

    <!-- شاشة تسجيل الدخول -->
    <div id="login-screen" class="absolute inset-0 bg-slate-900 z-[100] flex items-center justify-center transition-opacity duration-500">
        <div class="bg-white p-10 rounded-[2rem] shadow-2xl w-full max-w-sm text-center mx-4 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-full h-1.5 bg-gradient-to-r from-emerald-400 to-brand-primary"></div>
            <div class="w-20 h-20 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-6 shadow-inner border border-emerald-100">
                <i class="fa-solid fa-kiwi-bird text-4xl text-brand-primary"></i>
            </div>
            <h1 class="text-3xl font-black mb-2 text-slate-800 tracking-tight">سمان ههيا</h1>
            <p class="text-xs text-slate-500 font-bold mb-8 uppercase tracking-widest">الإدارة المركزية (CRM المطور)</p>
            
            <div class="space-y-4 mb-6">
                <input type="email" id="login-email" class="w-full border border-slate-200 bg-slate-50 rounded-xl p-3.5 text-left outline-none focus:border-brand-primary font-bold text-sm" dir="ltr" placeholder="admin@example.com">
                <input type="password" id="login-password" class="w-full border border-slate-200 bg-slate-50 rounded-xl p-3.5 text-left outline-none focus:border-brand-primary font-bold text-sm" dir="ltr" placeholder="••••••••">
            </div>
            
            <button onclick="loginApp()" id="login-btn" class="w-full bg-brand-primary hover:bg-emerald-800 text-white font-black py-3.5 rounded-xl transition-all shadow-lg shadow-brand-primary/30 flex justify-center items-center gap-2">تسجيل الدخول</button>
            <p id="login-error" class="hidden text-red-500 text-xs font-bold mt-4 bg-red-50 p-2 rounded-lg"></p>
        </div>
    </div>

    <div id="mobile-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/40 z-30 hidden md:hidden backdrop-blur-sm transition-opacity"></div>

    <!-- القائمة الجانبية -->
    <aside id="sidebar" class="w-64 bg-brand-dark text-slate-300 flex flex-col shadow-2xl z-40 fixed inset-y-0 right-0 md:relative h-full border-l border-emerald-900/50">
        <div class="h-[72px] flex items-center justify-between px-6 border-b border-emerald-800/50 bg-emerald-900/25 shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-500 text-white flex items-center justify-center font-black shadow-soft"><i class="fa-solid fa-crown text-sm"></i></div>
                <h1 class="text-lg font-black text-white tracking-wide">الإدارة المركزية</h1>
            </div>
            <button onclick="toggleSidebar()" class="md:hidden text-emerald-200 hover:text-white transition-colors"><i class="fa-solid fa-xmark text-xl"></i></button>
        </div>
        
        <nav class="flex-1 overflow-y-auto custom-scroll py-6 px-4 space-y-1">
            <button onclick="switchTab('dashboard', this)" class="nav-btn active w-full text-right flex items-center px-4 py-3 rounded-xl text-sm font-bold bg-emerald-600/20 text-white shadow-sm mb-4 border border-emerald-500/30 transition-all"><i class="fa-solid fa-chart-line w-7 text-center text-emerald-400"></i> لوحة القيادة</button>
            
            <div class="pt-2 pb-2 px-2 text-[10px] uppercase font-black text-emerald-300/50 tracking-wider">المبيعات والعملاء</div>
            <button onclick="switchTab('orders', this)" class="nav-btn w-full text-right flex items-center px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-800/50 hover:text-white text-emerald-100/70 transition-all"><i class="fa-solid fa-bolt w-7 text-center text-amber-400"></i> الطلبات الحية</button>
            <button onclick="switchTab('customers', this)" class="nav-btn w-full text-right flex items-center px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-800/50 hover:text-white text-emerald-100/70 transition-all"><i class="fa-solid fa-users w-7 text-center text-blue-400"></i> أرشيف العملاء</button>
            <button onclick="switchTab('notes', this)" class="nav-btn w-full text-right flex items-center px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-800/50 hover:text-white text-emerald-100/70 transition-all"><i class="fa-solid fa-clipboard-list w-7 text-center text-rose-400"></i> مركز الملاحظات</button>
            <button onclick="switchTab('debts', this)" class="nav-btn w-full text-right flex items-center px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-red-500/20 hover:text-white text-emerald-100/70 transition-all"><i class="fa-solid fa-book-journal-whills w-7 text-center text-red-400"></i> سجل المديونيات</button>
            <button onclick="switchTab('blacklist', this)" class="nav-btn w-full text-right flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-red-600/30 hover:text-white text-emerald-100/70 transition-all border-b border-emerald-900/50 pb-4 mb-2">
                <span class="flex items-center"><i class="fa-solid fa-ban w-7 text-center text-red-500"></i> قائمة البلاك ليست</span>
                <span id="sidebar-blacklist-badge" class="bg-red-600 text-white text-[10px] font-black px-2 py-0.5 rounded-full shadow-sm">0</span>
            </button>

            <div class="pt-6 pb-2 px-2 text-[10px] uppercase font-black text-emerald-300/50 tracking-wider">التحكم والتجهيز</div>
            <button onclick="switchTab('inventory', this)" class="nav-btn w-full text-right flex items-center px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-800/50 hover:text-white text-emerald-100/70 transition-all"><i class="fa-solid fa-boxes-packing w-7 text-center text-indigo-400"></i> الأصناف والأسعار</button>
            <button onclick="switchTab('batches', this)" class="nav-btn w-full text-right flex items-center px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-800/50 hover:text-white text-emerald-100/70 transition-all"><i class="fa-solid fa-layer-group w-7 text-center text-teal-400"></i> إدارة الدفعات</button>
            <button onclick="switchTab('archive', this)" class="nav-btn w-full text-right flex items-center px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-800/50 hover:text-white text-emerald-100/70 transition-all"><i class="fa-solid fa-box-archive w-7 text-center text-slate-400"></i> أرشيف الدفعات</button>
            <button onclick="switchTab('radar', this)" class="nav-btn w-full text-right flex items-center px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-800/50 hover:text-white text-emerald-100/70 transition-all mb-1"><i class="fa-solid fa-satellite-dish w-7 text-center text-amber-400 animate-pulse"></i> رادار المناديب</button>
            <button onclick="switchTab('reconciliation', this)" class="nav-btn w-full text-right flex items-center px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-800/50 hover:text-white text-emerald-100/70 transition-all"><i class="fa-solid fa-hand-holding-dollar w-7 text-center text-emerald-400"></i> تقفيل المناديب</button>
            <button onclick="switchTab('settings', this)" class="nav-btn w-full text-right flex items-center px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-emerald-800/50 hover:text-white text-emerald-100/70 transition-all"><i class="fa-solid fa-gear w-7 text-center text-slate-400"></i> إعدادات المتجر</button>

            <div class="my-2 border-t border-slate-700/50"></div>
            <button onclick="switchTab('trash', this)" class="nav-btn w-full text-right flex items-center px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-red-500/20 hover:text-red-300 text-emerald-100/70 transition-all"><i class="fa-solid fa-trash-can w-7 text-center text-red-400"></i> سلة المحذوفات</button>
        </nav>
        
        <div class="p-4 border-t border-emerald-800/50 bg-emerald-900/25 shrink-0">
            <button onclick="logoutApp()" class="text-red-300 hover:text-white hover:bg-red-500/80 transition-all flex items-center gap-2 text-sm font-bold w-full justify-center py-2.5 bg-red-500/10 rounded-xl border border-red-500/20"><i class="fa-solid fa-right-from-bracket"></i> خروج آمن</button>
        </div>
    </aside>

    <!-- الهيكل الرئيسي -->
    <main class="flex-1 flex flex-col min-w-0 h-full relative">
        <header class="h-[72px] bg-white border-b border-slate-200/60 flex items-center justify-between px-4 lg:px-8 shadow-sm z-10 shrink-0">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="md:hidden w-10 h-10 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 flex items-center justify-center hover:bg-slate-100 transition-colors"><i class="fa-solid fa-bars"></i></button>
                <h2 id="header-title" class="text-xl font-black text-slate-800 tracking-tight">لوحة القيادة</h2>
            </div>
            <div class="flex items-center gap-3">
                <span class="hidden md:flex items-center gap-1.5 text-xs font-bold text-emerald-600 bg-emerald-50 border border-emerald-100 px-4 py-2 rounded-full shadow-sm"><i class="fa-solid fa-circle-dot text-[10px] animate-pulse text-emerald-500"></i> متصل لايف</span>
                <button onclick="forceUpdateAppNow()" title="تحديث التطبيق فوراً" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 px-3 py-2 rounded-xl text-xs font-black transition-all flex items-center gap-1.5 active:scale-95"><i class="fa-solid fa-rotate"></i> <span class="hidden sm:inline">تحديث</span></button>
                <button onclick="saveAllSettings()" id="global-save-btn" class="bg-slate-800 hover:bg-slate-900 text-white px-5 py-2 rounded-xl text-sm font-bold shadow-md transition-all flex items-center gap-2 hidden"><i class="fa-solid fa-cloud-arrow-up text-amber-400"></i> حفظ التعديلات</button>
                <button onclick="openModal('add-order-modal')" class="bg-brand-primary hover:bg-emerald-800 text-white px-5 py-2 rounded-xl text-sm font-bold shadow-lg shadow-brand-primary/20 transition-all flex items-center gap-2 active:scale-95"><i class="fa-solid fa-plus"></i> <span class="hidden md:inline">إنشاء طلب</span></button>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto custom-scroll p-4 lg:p-8 pb-24 bg-slate-50/50">

            <!-- 1. لوحة القيادة -->
            <div id="view-dashboard" class="page-view active space-y-6 max-w-7xl mx-auto">
                <div class="relative w-full z-50">
                    <div class="relative bg-white rounded-2xl shadow-soft border-2 border-brand-primary/20 focus-within:border-brand-primary focus-within:ring-4 focus-within:ring-brand-primary/10 transition-all flex items-center overflow-hidden">
                        <div class="w-14 h-14 bg-brand-primary/5 text-brand-primary flex items-center justify-center text-xl shrink-0">
                            <i class="fa-solid fa-magnifying-glass animate-pulse"></i>
                        </div>
                        <input type="text" id="global-emergency-search" oninput="scheduleGlobalSearch(this.value)" placeholder="كشاف الطوارئ: اكتب رقم أو اسم العميل للوصول السريع..." class="w-full h-14 bg-transparent border-none outline-none px-4 font-black text-slate-800 text-base md:text-lg placeholder:text-slate-400 placeholder:font-bold">
                        <button onclick="document.getElementById('global-emergency-search').value=''; document.getElementById('global-search-results').classList.add('hidden');" class="w-14 h-14 text-slate-300 hover:text-red-500 transition-colors shrink-0">
                            <i class="fa-solid fa-xmark text-xl"></i>
                        </button>
                    </div>
                    <div id="global-search-results" class="hidden absolute top-[calc(100%+8px)] right-0 w-full bg-white rounded-2xl shadow-2xl border border-slate-100 max-h-[60vh] overflow-y-auto custom-scroll flex flex-col divide-y divide-slate-50"></div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6">
                    <div class="bg-white p-6 rounded-[1.5rem] border border-slate-100 shadow-soft flex flex-col justify-between hover:shadow-card transition-shadow cursor-pointer" onclick="openFinanceReport('day')">
                        <div class="flex justify-between items-start mb-4">
                            <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center text-lg"><i class="fa-solid fa-check-double"></i></div>
                            <span class="text-[9px] bg-blue-50 text-blue-600 px-2 py-0.5 rounded font-black">تقرير اليوم</span>
                        </div>
                        <div><p class="text-xs font-bold text-slate-400 mb-1">تم تسليمه اليوم</p><h3 id="dash-completed-today" class="text-3xl font-black text-slate-800">0</h3></div>
                    </div>
                    
                    <div class="bg-white p-6 rounded-[1.5rem] border border-slate-100 shadow-soft flex flex-col justify-between hover:shadow-card transition-shadow relative overflow-hidden">
                        <div class="absolute -right-4 -top-4 w-24 h-24 bg-emerald-50 rounded-full opacity-50 pointer-events-none"></div>
                        <div class="flex justify-between items-start mb-4 relative z-10">
                            <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-lg"><i class="fa-solid fa-sack-dollar"></i></div>
                        </div>
                        <div class="relative z-10"><p class="text-xs font-bold text-slate-500 mb-1">إجمالي المنتجات (بدون توصيل)</p><h3 id="dash-products-today" class="text-3xl font-black text-brand-primary">0 <span class="text-sm text-slate-400">ج</span></h3></div>
                    </div>

                    <div class="bg-white p-6 rounded-[1.5rem] border border-slate-100 shadow-soft flex flex-col justify-between hover:shadow-card transition-shadow relative overflow-hidden">
                        <div class="absolute -right-4 -top-4 w-24 h-24 bg-indigo-50 rounded-full opacity-50 pointer-events-none"></div>
                        <div class="flex justify-between items-start mb-4 relative z-10">
                            <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-lg"><i class="fa-solid fa-motorcycle"></i></div>
                        </div>
                        <div class="relative z-10"><p class="text-xs font-bold text-slate-500 mb-1">إيرادات التوصيل (اليوم)</p><h3 id="dash-delivery-today" class="text-3xl font-black text-indigo-600">0 <span class="text-sm text-slate-400">ج</span></h3></div>
                    </div>

                    <div class="bg-white p-6 rounded-[1.5rem] border border-slate-100 shadow-soft flex flex-col justify-between hover:shadow-card transition-all relative overflow-hidden cursor-pointer" onclick="openFinanceReport('month')">
                        <div class="absolute -right-4 -top-4 w-24 h-24 bg-amber-50 rounded-full opacity-50 pointer-events-none"></div>
                        <div class="flex justify-between items-start mb-4 relative z-10">
                            <div class="w-10 h-10 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-lg"><i class="fa-solid fa-wallet"></i></div>
                            <span class="text-[9px] bg-amber-50 text-amber-700 px-2 py-0.5 rounded font-black">تقرير الشهر</span>
                        </div>
                        <div class="relative z-10"><p class="text-xs font-bold text-slate-500 mb-1">إجمالي تحصيل اليوم</p><h3 id="dash-total-today" class="text-3xl font-black text-amber-600">0 <span class="text-sm text-slate-400">ج</span></h3></div>
                    </div>
                </div>
                
                <div class="w-full bg-white p-6 rounded-[1.5rem] border border-slate-100 shadow-soft mt-2">
                    <h4 class="text-sm font-black text-slate-800 mb-4 pb-2 border-b border-slate-50"><i class="fa-solid fa-boxes-packing text-brand-primary mr-2"></i> إجمالي المنتجات المسلمة اليوم</h4>
                    <div id="dash-items-today" class="grid grid-cols-2 md:grid-cols-6 gap-3"></div>
                </div>

                <div class="w-full bg-white p-6 rounded-[1.5rem] border border-slate-100 shadow-soft mt-2 mb-6">
                    <h4 class="text-sm font-black text-slate-800 mb-4 pb-2 border-b border-slate-50"><i class="fa-solid fa-list-check text-indigo-500 mr-2"></i> سجل تسليمات اليوم التفصيلي (من استلم اليوم؟)</h4>
                    <div class="overflow-x-auto custom-scroll">
                        <table class="w-full text-right text-sm whitespace-nowrap">
                            <thead class="bg-slate-50 text-slate-500">
                                <tr>
                                    <th class="py-3 px-4 font-black rounded-r-xl">العميل</th>
                                    <th class="py-3 px-4 font-black text-center">المنتجات التي استلمها</th>
                                    <th class="py-3 px-4 font-black text-center">تاريخ الطلب الأصلي</th>
                                    <th class="py-3 px-4 font-black text-center rounded-l-xl">المدفوع</th>
                                </tr>
                            </thead>
                            <tbody id="dash-today-orders-tbody" class="divide-y divide-slate-50"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 2. الطلبات الحية (الغرفة العصبية المحدثة www/orders.js) -->
            <div id="view-orders" class="page-view h-full flex flex-col max-w-7xl mx-auto relative">
                <div class="sticky top-[-1rem] lg:top-[-2rem] z-40 bg-[#f1f5f9]/95 backdrop-blur-md pt-4 pb-3 -mx-4 px-4 lg:-mx-8 lg:px-8 border-b border-slate-200/60 shadow-sm mb-4">
                    
                    <!-- شريط البحث السريع والخيارات -->
                    <div class="flex flex-col md:flex-row justify-between items-center gap-3 mb-3">
                        <div class="relative w-full md:flex-1 flex gap-2">
                            <div class="relative flex-1">
                                <div class="absolute right-3 top-2.5 w-7 h-7 bg-brand-primary/10 rounded-lg flex items-center justify-center pointer-events-none">
                                    <i class="fa-solid fa-search text-brand-primary text-xs"></i>
                                </div>
                                <button onclick="document.getElementById('search-order').value=''; scheduleSearch();" class="absolute left-3 top-2.5 w-7 h-7 text-slate-300 hover:text-red-500 hover:bg-red-50 rounded-lg flex items-center justify-center transition-colors">
                                    <i class="fa-solid fa-xmark text-xs"></i>
                                </button>
                                <input type="search" id="search-order" onkeyup="scheduleSearch()" placeholder="بحث سريع في الطلبات (اسم، موبايل، صنف)..." class="w-full pr-12 pl-12 py-3 rounded-xl border border-slate-200 outline-none text-sm font-black bg-white focus:ring-2 focus:ring-brand-primary/30 transition-all shadow-sm">
                            </div>
                            <button onclick="toggleOrderSort()" id="btn-sort-orders" class="w-12 shrink-0 bg-white border border-slate-200 rounded-xl text-slate-500 hover:text-brand-primary hover:border-brand-primary hover:bg-emerald-50 transition-colors flex items-center justify-center shadow-sm" title="الترتيب الزمني">
                                <i class="fa-solid fa-arrow-down-short-wide text-lg"></i>
                            </button>
                        </div>

                        <!-- أدوات التشغيل -->
                        <div class="relative w-full md:w-auto shrink-0 group">
                            <button class="w-full md:w-auto bg-slate-800 text-white px-5 py-3 rounded-xl text-sm font-bold shadow-md hover:bg-slate-900 transition-all flex items-center justify-center gap-2">
                                <i class="fa-solid fa-toolbox text-amber-400"></i> أدوات التشغيل <i class="fa-solid fa-chevron-down text-[10px] ml-1 opacity-70"></i>
                            </button>
                            <div class="hidden group-hover:flex flex-col absolute left-0 top-full mt-1 w-full md:w-56 bg-white rounded-xl shadow-xl border border-slate-100 overflow-hidden z-50">
                                <button onclick="openDispatchModal()" class="flex items-center gap-2 px-4 py-3 hover:bg-blue-50 text-slate-700 font-bold text-sm text-right transition-colors border-b border-slate-50"><i class="fa-solid fa-motorcycle text-blue-500 w-5 text-center"></i> التوجيه للمندوب</button>
                                <button onclick="openPackingListModal()" class="flex items-center gap-2 px-4 py-3 hover:bg-amber-50 text-slate-700 font-bold text-sm text-right transition-colors border-b border-slate-50"><i class="fa-solid fa-box-open text-amber-500 w-5 text-center"></i> ورقة التحضير الذكية</button>
